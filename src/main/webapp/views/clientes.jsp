<%@ page import="java.util.*,com.controlstock.model.Cliente" contentType="text/html;charset=UTF-8" %><% List<Cliente> lista=(List<Cliente>)request.getAttribute("clientes"); %><!doctype html><html><head><title>Clientes</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><%@ include file="header.jsp" %><main><section><h2>Clientes</h2><table><tr><th>ID</th><th>Nombre</th><th>Correo</th><th>Teléfono</th></tr><%for(Cliente c:lista){%><tr><td><%=c.getId()%></td><td><%=c.getNombre()%></td><td><%=c.getCorreo()%></td><td><%=c.getTelefono()%></td></tr><%}%></table></section></main><%@ include file="footer.jsp" %></body></html>