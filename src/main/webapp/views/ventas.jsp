<%@ page import="java.util.*,com.controlstock.model.Venta" contentType="text/html;charset=UTF-8" %><% List<Venta> lista=(List<Venta>)request.getAttribute("ventas"); %><!doctype html><html><head><title>Ventas</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><%@ include file="header.jsp" %><main><section><h2>Ventas</h2><table><tr><th>ID</th><th>Cliente</th><th>Producto</th><th>Cantidad</th><th>Total</th><th>Fecha</th></tr><%for(Venta v:lista){%><tr><td><%=v.getId()%></td><td><%=v.getClienteId()%></td><td><%=v.getProductoId()%></td><td><%=v.getCantidad()%></td><td>$<%=v.getTotal()%></td><td><%=v.getFecha()%></td></tr><%}%></table></section></main><%@ include file="footer.jsp" %></body></html>