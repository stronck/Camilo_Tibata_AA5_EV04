<%@ page import="java.util.*,com.controlstock.model.Producto" contentType="text/html;charset=UTF-8" %><% List<Producto> lista=(List<Producto>)request.getAttribute("productos"); %><!doctype html><html><head><title>Productos</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><%@ include file="header.jsp" %><main><section><h2>Productos</h2><table><tr><th>ID</th><th>Nombre</th><th>Precio</th><th>Stock</th></tr><%for(Producto p:lista){%><tr><td><%=p.getId()%></td><td><%=p.getNombre()%></td><td>$<%=p.getPrecio()%></td><td><%=p.getStock()%></td></tr><%}%></table></section></main><%@ include file="footer.jsp" %></body></html>